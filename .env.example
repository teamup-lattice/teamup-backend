# PostgreSQL connection string (required)
# Used by Prisma (prisma.config.js) and the app (source/db/client.js)
DATABASE_URL=postgres://username:password@localhost:5432/database_name

# Secret for signing/verifying JWT access tokens (required, minimum 32 characters)
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_me_with_a_random_secret_at_least_32_chars_long

# Optional settings (defaults shown)
# PORT=4000
# NODE_ENV=development
# ACCESS_TOKEN_TTL=15m
# REFRESH_TOKEN_TTL_DAYS=30

# ─── Password reset (SendLiberty) ─────────────────────────────────────────────
# API key for https://sendliberty.com — used instead of SMTP so email works on
# hosts that block outbound SMTP connections (e.g. Render's free tier).
# SEND_LIBERTY=your_api_key

# Optional endpoint override. Defaults to https://sendliberty.com/api/send
# SEND_LIBERTY_URL=https://sendliberty.com/api/send

# "From" address shown in password-reset emails. Must be a sender that
# SendLiberty allows for your account.
# EMAIL_FROM="TeamUP <no-reply@example.com>"

# Optional Reply-To address for password-reset emails.
# EMAIL_REPLY_TO="TeamUP Support <support@example.com>"

# Frontend base URL used to build the reset link in the email
# The reset link will be: FRONTEND_URL/reset-password?token=...
# Defaults to http://localhost:5173 in development
# FRONTEND_URL=https://yourapp.example.com

# How long (minutes) a password-reset link stays valid. Min 5. Default 30.
# PASSWORD_RESET_TTL_MINUTES=30

# ─── Redis (optional) ────────────────────────────────────────────────────────
# Without a URL, the API reads directly from PostgreSQL on every request.
# REDIS_URL=redis://localhost:6379

# ─── Cloudinary (required) ───────────────────────────────────────────────────
# Used by POST /api/uploads. The app refuses to start if this is missing or
# malformed, so upload failures are caught at boot instead of at request time.
# Format: cloudinary://api_key:api_secret@cloud_name
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# Maximum uploads per authenticated user per hour.
# Defaults to 20 in production and 100 in development.
# UPLOAD_RATE_LIMIT_MAX=20
